# Optional LLM fallback. Common supported questions work without an API key.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ENABLE_LLM_FALLBACK=false
USE_LLM_ANSWER=false

# Optional OpenAI adapter. No OpenAI key is needed for the default local flow.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# The bundled sample database is used on first launch.
# User-selected connections made in Settings are held in memory until restart.
DATABASE_URL=
MAX_RESULT_ROWS=200
MAX_RECOVERY_RETRIES=1

# Comma-separated frontend origins when frontend/backend are on different hosts.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
